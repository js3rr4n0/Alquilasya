# Postgres (Neon). Al conectar la base desde Vercel → Storage, esta variable
# (o POSTGRES_URL) se crea sola en el proyecto.
DATABASE_URL=

# Vercel Blob, para las fotos que suben quienes publican. Se crea sola al
# conectar un almacén Blob público desde Vercel → Storage. Basta una de las dos:
# BLOB_STORE_ID (almacenes nuevos) o BLOB_READ_WRITE_TOKEN. Sin ellas los
# anuncios se publican sin fotos.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Correos (separados por coma) de las cuentas que ven la sala /admin.
# La cuenta tiene que haber confirmado su correo con el código.
ADMIN_EMAILS=
# Opcional: clave para la huella de IP de la analítica propia (cualquier texto largo y aleatorio).
ANALYTICS_SECRET=

# Envío de correos con Resend (códigos de verificación y avisos de mensajes).
# MAIL_FROM debe usar un dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM=AlquilasYa <contacto@alquilasya.com>

# Código de verificación de Google Search Console (solo el valor del atributo content).
GOOGLE_SITE_VERIFICATION=

# Medición de campañas (opcional). GA4: G-XXXXXXX. Google Ads: AW-XXXXXXXXX.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Reinicio total de la base: BORRA TODO. Cada valor se aplica una sola vez.
# DB_RESET=2026-11-17

# Dominio público, sin barra final. Se usa en el sitemap, las URL canónicas y al compartir.
NEXT_PUBLIC_SITE_URL=https://alquilasya.com

# Wompi (pagos para destacar anuncios). App ID y API Secret del negocio en panel.wompi.sv.
WOMPI_APP_ID=
WOMPI_API_SECRET=
# Opcional: correos que Wompi avisa en cada pago (separados por coma).
WOMPI_AVISOS=
# Solo pruebas: 1 = aceptar pagos de un negocio en modo desarrollo (no cobran).
WOMPI_ACEPTAR_PRUEBAS=
