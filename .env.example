# Postgres (Neon). Al conectar la base desde Vercel → Storage, esta variable
# (o POSTGRES_URL) se crea sola en el proyecto.
DATABASE_URL=

# Vercel Blob, para las fotos que suben quienes publican. Se crea sola al
# conectar un almacén Blob desde Vercel → Storage. Sin ella el sitio funciona
# con fotos de muestra.
BLOB_READ_WRITE_TOKEN=

# Clave para entrar a /admin (mínimo 12 caracteres). Elige una larga y única.
ADMIN_TOKEN=

# Dominio público, para los metadatos al compartir enlaces.
NEXT_PUBLIC_SITE_URL=https://alquilasya.com
